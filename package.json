{
  "name": "@rrdongdong/dsh-pdf",
  "version": "0.4.2",
  "description": "PDF text extraction that survives CID/ObjStm fonts (CVPR/IEEE PDFs) — DSH/Cordis tools",
  "keywords": [
    "dsh",
    "cordis",
    "deepseek-harness",
    "pdf",
    "pdfjs",
    "cid-font",
    "toUnicode",
    "objstm",
    "tool"
  ],
  "author": "rrdongdong",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib/",
    "bin/",
    "CHANGELOG.md",
    "docs/",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "preflight": "node bin/preflight.mjs",
    "preflight:pdf": "node bin/preflight.mjs ./fixtures/sample.pdf"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrdongdong/dsh-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/rrdongdong/dsh-pdf/issues"
  },
  "homepage": "https://github.com/rrdongdong/dsh-pdf#readme",
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
